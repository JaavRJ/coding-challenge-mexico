# Supabase PostgreSQL JDBC Connection
# Reemplaza [TU-PASSWORD] con tu contraseña real de base de datos de Supabase
DATABASE_URL=jdbc:postgresql://db.kuostgknlbzamzjeewhf.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=TU-PASSWORD-AQUI

# Supabase API & Roles (para futuras extensiones o llamadas directas del frontend)
SUPABASE_URL=https://kuostgknlbzamzjeewhf.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
